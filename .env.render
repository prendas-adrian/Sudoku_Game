# Render.com Deployment Environment Template
# Copy and adjust these values when deploying

# Node Configuration
NODE_ENV=production
PORT=8080

# MongoDB Configuration
# Option 1: Using Render's MongoDB (if using render.yaml)
# MONGODB_URI will be auto-injected by Render

# Option 2: Using MongoDB Atlas
# Get this from https://cloud.mongodb.com/v2
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/sudoku?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://root:example@cluster0.mongodb.net/sudoku?retryWrites=true&w=majority

# Frontend API URL (for client configuration)
# Update in client/src/app/services/global.ts
API_URL=https://sudoku-backend.onrender.com/api/
